{
  "name": "vscode-184142-repro",
  "version": "0.0.1",
  "publisher": "orqelon-local",
  "repository": { "type": "git", "url": "https://github.com/ahcrm-core/vscode-184142-repro.git" },
  "private": true,
  "description": "Isolated diagnostic for microsoft/vscode#184142",
  "main": "extension.cjs",
  "engines": { "vscode": "^1.90.0" },
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "activationEvents": ["onStartupFinished", "onCustomEditor:orqelon.issue184142", "onCommand:orqelon.issue184142.edit", "onCommand:orqelon.issue184142.alive"],
  "contributes": {
    "customEditors": [{
      "viewType": "orqelon.issue184142",
      "displayName": "Issue 184142 probe",
      "selector": [{ "filenamePattern": "*.orqtest" }],
      "priority": "default"
    }],
    "commands": [
      { "command": "orqelon.issue184142.edit", "title": "Issue 184142: Edit active probe" },
      { "command": "orqelon.issue184142.alive", "title": "Issue 184142: Record alive and open documents" }
    ]
  },
  "scripts": { "ci": "node scripts/ci.cjs", "package": "vsce package --no-dependencies -o artifacts/probe.vsix" },
  "devDependencies": { "@vscode/test-electron": "2.5.2", "@vscode/vsce": "4.0.0" }
}
